INFRA_AUDITOR_ENVIRONMENT=local
INFRA_AUDITOR_AWS_REGION=ap-south-1
# INFRA_AUDITOR_AWS_PROFILE=your-sso-profile
INFRA_AUDITOR_LOG_LEVEL=INFO
INFRA_AUDITOR_LOG_FORMAT=console
INFRA_AUDITOR_RESOURCE_CONFIG_PATH=config/environments.example.yaml
INFRA_AUDITOR_SNAPSHOT_OUTPUT_DIR=data/snapshots
INFRA_AUDITOR_BOOTSTRAP_DATABASE=postgres
INFRA_AUDITOR_POSTGRES_SSL_MODE=require
INFRA_AUDITOR_POSTGRES_CONNECT_TIMEOUT_SECONDS=10
